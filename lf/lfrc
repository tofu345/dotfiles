set hidden
set incfilter
set incsearch
set previewer 'pistol'
set promptfmt " \033[34;1m%d\033[0m\033[1m%f\033[0m"
set ratios 2:6
set relativenumber
set scrolloff 1
set truncatechar '…'

# # https://github.com/gokcehan/lf/wiki/Integrations#eza
